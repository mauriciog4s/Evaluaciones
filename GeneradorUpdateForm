/**
 * 🛠️ GENERADOR DE FORMULARIO DE ACTUALIZACIÓN DE DATOS + HABEAS DATA
 */

function crearFormularioUpdate() {
  const form = FormApp.create('Actualización de Datos y Habeas Data - Talent Assessment');
  form.setDescription("ACTUALIZACIÓN OBLIGATORIA DE DATOS\n\nPara continuar con el proceso de evaluación, es necesario confirmar la información de contacto del colaborador.")
  .setConfirmationMessage('Datos actualizados correctamente. Por favor regrese al portal y haga clic en "CONTINUAR A EVALUACIÓN".')
  .setPublishingSummary(false).setShowLinkToRespondAgain(false);

  const itemHabeas = form.addCheckboxItem().setTitle('Términos y Condiciones - Habeas Data').setRequired(true);
  itemHabeas.setChoices([itemHabeas.createChoice('Conozco la Ley de Habeas Data vigente... y autorizo la recopilación de datos.')]);

  form.addSectionHeaderItem().setTitle('Validación de Identidad');
  const itemCedula = form.addTextItem().setTitle('Cédula del Colaborador').setRequired(true);
  const itemNombre = form.addTextItem().setTitle('Nombre del Colaborador').setRequired(true);
  
  form.addSectionHeaderItem().setTitle('Información de Contacto Actual y Sociodemográfica');
  form.addTextItem().setTitle('Dirección de Residencia Actual').setRequired(true).setHelpText('Indique Dirección, Barrio y Ciudad');
  form.addTextItem().setTitle('Número de Celular Actual').setRequired(true);
  form.addTextItem().setTitle('Correo Electrónico Personal').setRequired(true).setValidation(FormApp.createTextValidation().requireTextIsEmail().build());

  // NUEVOS CAMPOS SOLICITADOS
  form.addMultipleChoiceItem().setTitle('Género').setChoiceValues(['Masculino', 'Femenino']).showOtherOption(true).setRequired(true);
  form.addTextItem().setTitle('Nombre contacto emergencia').setRequired(true);
  form.addTextItem().setTitle('Número contacto emergencia').setRequired(true);
  form.addTextItem().setTitle('Edad actual').setRequired(true);
  form.addListItem().setTitle('Estado civil').setChoiceValues(['Soltero/a', 'Casado/a', 'Unión Libre', 'Separado/a', 'Divorciado/a', 'Viudo/a']).setRequired(true);
  form.addListItem().setTitle('Nivel escolaridad actual').setChoiceValues(['Primaria', 'Bachillerato', 'Técnico', 'Tecnólogo', 'Profesional', 'Posgrado', 'Ninguno']).setRequired(true);
  form.addTextItem().setTitle('Tipo contrato').setRequired(true);
  form.addTextItem().setTitle('Antigüedad en la empresa').setRequired(true);
  form.addTextItem().setTitle('¿Cuántas personas viven en su hogar?').setRequired(true);
  form.addTextItem().setTitle('¿Cuántas personas dependen económicamente de ti?').setRequired(true);
  form.addTextItem().setTitle('Numero de hijos').setRequired(true);

  const formResponse = form.createResponse();
  formResponse.withItemResponse(itemCedula.createResponse("DATA_CEDULA"));
  formResponse.withItemResponse(itemNombre.createResponse("DATA_NOMBRE"));
  const urlPrefilled = formResponse.toPrefilledUrl();
  
  console.log("✅ FORMULARIO DE ACTUALIZACIÓN CREADO");
  const idCedula = extractEntryId(urlPrefilled, "DATA_CEDULA");
  const idNombre = extractEntryId(urlPrefilled, "DATA_NOMBRE");

  console.log(`
  UPDATE_FORM_BASE: '${form.getPublishedUrl()}?usp=pp_url' 
                   + '&entry.${idCedula}={{CEDULA}}'
                   + '&entry.${idNombre}={{NOMBRE}}'
  `);
}

function extractEntryId(url, placeholder) { const match = url.match(new RegExp(`entry\\.(\\d+)=${placeholder}`)); return match ? match[1] : "NO_ENCONTRADO"; }
